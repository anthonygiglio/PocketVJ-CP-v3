[Unit]
Description=nxlx.mastercontrol remote support helper (opens and closes a support tunnel)
After=network.target
StartLimitIntervalSec=0

[Service]
# Root with one capability: it creates the WireGuard interface wg-pvj and its firewall table, and answers only root
# and pvj-web on its socket. It removes any tunnel left by an earlier run when it starts and when it stops.
User=root
Group=pvj
UMask=0027
RuntimeDirectory=pvj-supportd
RuntimeDirectoryMode=0750
StateDirectory=pvj-support
StateDirectoryMode=0700
Environment=PVJ_SUPPORTD_DIR=/run/pvj-supportd PVJ_SUPPORT_KEYS=/var/lib/pvj-support
ExecStart=@PVJ_DIR@/bin/pvj-supportd
Restart=always
RestartSec=2

CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/pvj-supportd
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectProc=invisible
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Netlink to create the interface and the firewall; IPv4/IPv6 so wg can look up the support server's name.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
