[Unit]
Description=nxlx.mastercontrol web panel and control API
After=network.target pvj-player.service
Wants=pvj-player.service
StartLimitIntervalSec=0

[Service]
# Talks to the player only through its socket in /run/pvj (group "pvj"); it has
# no access to the screen or the sound card. The one device it may read is a USB MIDI
# controller (/dev/snd/midi*, group "audio"), for the optional MIDI module.
User=pvj-web
Group=pvj
SupplementaryGroups=audio
UMask=0007
RuntimeDirectory=pvj
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
Environment=PVJ_RUNTIME_DIR=/run/pvj
Environment=PVJ_STATE_DIR=/var/lib/pvj
Environment=PVJ_BIND=0.0.0.0
Environment=PVJ_PORT=80
EnvironmentFile=-/etc/pvj/pvj.env
ExecStart=@PVJ_DIR@/bin/pvj-web
Restart=always
RestartSec=1

# Sandbox
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Not PrivateDevices: that would hide /dev/snd/midi*. The device policy allows only the basic
# devices and read access to ALSA (MIDI) devices.
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
DeviceAllow=char-alsa r
ReadWritePaths=/var/lib/pvj /run/pvj
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
