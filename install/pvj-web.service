[Unit]
Description=NXLX PocketVJ web panel and control API
After=network.target pvj-player.service
Wants=pvj-player.service
StartLimitIntervalSec=0

[Service]
# Talks to the player only through its socket in /run/pvj (group "pvj"); it has
# no access to the screen, sound card or the rest of the system.
User=pvj-web
Group=pvj
UMask=0007
RuntimeDirectory=pvj
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
Environment=PVJ_RUNTIME_DIR=/run/pvj
Environment=PVJ_STATE_DIR=/var/lib/pvj
Environment=PVJ_BIND=0.0.0.0
Environment=PVJ_PORT=80
EnvironmentFile=-/etc/pvj/pvj.env
ExecStart=@PVJ_DIR@/bin/pvj-web
Restart=always
RestartSec=1

# Sandbox
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/pvj /run/pvj
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
