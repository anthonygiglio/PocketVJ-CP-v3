[Unit]
Description=nxlx.mastercontrol update uploaded through the panel (started from the panel through pvj-sysd)

[Service]
# Started on request only (no [Install]), as pvj-update-inbox@VERSION.service: the instance is the version the
# person confirmed in the panel (pvj-sysd checks it is N.N.N). pvj-update checks the bundle's signature against /etc/pvj/allowed_signers
# on a private copy before installing, refuses older versions, and rolls back by itself if the panel does not come
# back. Its progress goes to a small JSON file the panel reads.
Type=oneshot
User=root
RuntimeDirectory=pvj-update
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=@PVJ_DIR@/bin/pvj-update inbox --version %i --result /run/pvj-update/result.json
# Stopped before the end (the time limit below): say so, so the panel does not show "Updating" for ever.
ExecStopPost=-@PVJ_DIR@/bin/pvj-update finish --result /run/pvj-update/result.json
TimeoutStartSec=30min
