[Unit]
Description=nxlx.mastercontrol update from a USB drive (started from the panel through pvj-sysd)

[Service]
# Started on request only (no [Install]). pvj-update checks the bundle's signature against /etc/pvj/allowed_signers
# on a private copy before installing, refuses older versions, and rolls back by itself if the panel does not come
# back. Its progress goes to a small JSON file the panel reads.
Type=oneshot
User=root
RuntimeDirectory=pvj-update
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=@PVJ_DIR@/bin/pvj-update usb --result /run/pvj-update/result.json
TimeoutStartSec=30min
