[Unit]
Description=nxlx.mastercontrol player (mpv)
# Not After=multi-user.target: this unit is WantedBy=multi-user.target (a target waits for what it wants) and
# pvj-web is ordered after this unit, so that made a cycle and systemd silently deleted the start job. Found on a
# real Pi 4 (2026-09-30). Not udev-settle either (deprecated, and slow); Restart=always covers a display that is
# not ready yet.
After=local-fs.target systemd-udevd.service
StartLimitIntervalSec=0

[Service]
# The installer replaces @PVJ_USER@ with the account that owns the screen and
# sound card, and @PVJ_DIR@ with the install directory.
User=@PVJ_USER@
Group=pvj
SupplementaryGroups=video render audio input
# Control socket for the web panel and OSC: /run/pvj, group-writable by "pvj".
RuntimeDirectory=pvj
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
UMask=0007
EnvironmentFile=-/etc/pvj/pvj.env
Environment=PVJ_RUNTIME_DIR=/run/pvj
ExecStart=@PVJ_DIR@/bin/pvj-player serve
# A crashed or wedged player comes back on its own, mid-gig.
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
