[Unit]
Description=Mount USB drive %I for PocketVJ
# Stops (and unmounts) when the device disappears.
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/pvj/pvj.env
ExecStart=@PVJ_DIR@/bin/pvj-usb mount /dev/%I
ExecStop=@PVJ_DIR@/bin/pvj-usb unmount /dev/%I
